{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": "../.."
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "../../scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
